# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes

# PostgreSQL. Use a restricted runtime role in production.
DATABASE_URL=postgresql://fincontrol:fincontrol@localhost:5432/fincontrol?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/fincontrol?schema=public

# Storage: local in development, Vercel Blob in production
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/uploads
BLOB_READ_WRITE_TOKEN=

# Email: SMTP locally, Resend in production
EMAIL_DRIVER=smtp
EMAIL_FROM=FinControl <no-reply@finance.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Seed is refused in production and requires an explicit password
SEED_DEMO_PASSWORD=
CRON_SECRET=replace-with-a-random-cron-secret
